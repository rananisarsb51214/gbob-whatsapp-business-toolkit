‎2. BROADCAST 5000 MSGS KA CODE - backend/broadcast.js
‎WhatsApp 24-hour rule + rate limit ka khayal rakha hai
‎
‎FILE NAME: backend/broadcast.js
‎const axios = require('axios');
‎
‎const WHATSAPP_TOKEN = process.env.WHATSAPP_TOKEN;
‎const PHONE_NUMBER_ID = process.env.PHONE_NUMBER_ID;
‎
‎// 20 msg/sec ki speed. WhatsApp limit 1000/min
‎const DELAY_MS = 50; 
‎
‎const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));
‎
‎async function sendBroadcast(phoneNumbers, message) {
‎  let sent = 0;
‎  let failed = 0;
‎
‎  for (const number of phoneNumbers) {
‎    try {
‎      await axios.post(
‎        https://graph.facebook.com/v20.0/${PHONE_NUMBER_ID}/messages,
‎        {
‎          messaging_product: "whatsapp",
‎          to: number,
‎          type: "text",
‎          text: { body: message }
‎        },
‎        { headers: { 'Authorization': Bearer ${WHATSAPP_TOKEN} } }
‎      );
‎      sent++;
‎      console.log(Sent to ${number});
‎    } catch (err) {
‎      failed++;
‎      console.log(Failed ${number}:, err.response?.data?.error?.message);
‎    }
‎
‎    await sleep(DELAY_MS); // Rate limit avoid
‎  }
‎
‎  return { sent, failed };
‎}
‎
‎// API ROUTE
‎const express = require('express');
‎const app = express();
‎app.use(express.json());
‎
‎app.post('/broadcast', async (req, res) => {
‎  const { phoneNumbers, message } = req.body;
‎
‎  if(!phoneNumbers || phoneNumbers.length > 5000) {
‎    return res.status(400).json({ error: 'Max 5000 numbers allowed' });
‎  }
‎
‎  // Background me chalao taake API hang na ho
‎  sendBroadcast(phoneNumbers, message);
‎
‎  res.json({ status: "Broadcast started", total: phoneNumbers.length });
‎});
‎
‎module.exports = { sendBroadcast };
